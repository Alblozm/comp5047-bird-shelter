# Copy this file to .env and add your own key. .env is ignored by git, so the key never ends up in the repository.
# Any OpenAI-compatible chat API works. We used a service that provides gemini-2.5-flash.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gemini-2.5-flash
SHELTER_HOST=127.0.0.1
SHELTER_PORT=5047
SHELTER_TIMEZONE=Australia/Sydney
# Leave the serial ports blank to detect the boards by their USB chip.
CLIMATE_PORT=
CAMERA_PORT=
